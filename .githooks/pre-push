#!/usr/bin/env bash
# Pre-push hook — local behaviour only. Reads the refs being pushed from stdin
# and lets a push of `main` or a version branch (X.Y.Z) go out only when its
# commit is the one `uv run poe release_gates` last recorded as passed. Other
# branches and deletions are not checked. No gate runs inside the push.

zeros='^0+$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ $zeros ]] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/[0-9]*.[0-9]*.[0-9]*) ;;
    *) continue ;;
  esac
  recorded=$(cat "$(git rev-parse --git-common-dir)/ails-release-gates-passed" 2>/dev/null || true)
  if [ "$local_sha" != "$recorded" ]; then
    echo "Pre-push: ${remote_ref#refs/heads/} at ${local_sha:0:8} has not passed the release gates." >&2
    echo "Run: uv run poe release_gates (about 5 minutes), then push again." >&2
    status=1
  fi
done

exit "$status"
